# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=3001

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_QUARTERLY=price_...

# Where checkout returns the user after success/cancel
APP_URL=http://localhost:5173

# joolkit-scanner (server-to-server; never expose secret to the client)
SCANNER_BASE_URL=https://joolkit-scanner.fly.dev
SCANNER_PUBLIC_KEY=pk_live_...
SCANNER_SECRET_KEY=sk_live_...

# Optional, local dev only: force the pre-checkout display currency in the
# upgrade modal. Leave unset to default to USD.
# BILLING_DEBUG_CURRENCY=brl
