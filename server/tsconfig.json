{
  "compilerOptions": {
    "target": "ES2022",
    // nodenext keeps CommonJS output but preserves dynamic import() calls,
    // which commonjs would downlevel to require() — breaking ESM-only deps
    // (puppeteer-core, pdfjs-dist) on runtimes without require(esm) support.
    "module": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*"]
}
